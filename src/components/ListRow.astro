---
type Props = {
  href?: string;
};

const { href } = Astro.props;
---

<li class="border-b border-line sm:border-0">
  <a href={href} class="group flex flex-col gap-1.5 py-[18px] sm:grid sm:grid-cols-[76px_minmax(0,1fr)] sm:items-baseline sm:gap-4 sm:py-3">
    <slot name="label" />
    <span class="flex flex-col gap-1.5 sm:gap-1">
      <span data-row-title class="text-[20px] leading-[1.3] font-semibold group-hover:underline-subtle sm:leading-[1.35]"><slot name="title" /></span>
      <span data-row-text class="text-[16px] leading-normal text-fg-2"><slot name="text" /></span>
    </span>
  </a>
</li>
