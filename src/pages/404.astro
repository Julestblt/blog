---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <SiteHeader variant="page" />
  <section class="mt-12 flex flex-col gap-3 text-[18px] leading-[1.68] sm:mt-20 sm:gap-4 sm:text-[20px] sm:leading-[1.7]">
    <h1 class="text-[32px] leading-[1.15] font-bold tracking-[-0.02em] sm:text-[44px] sm:leading-[1.12]">Page not found</h1>
    <p class="text-fg-2">This page does not exist or has moved. <a href="/" class="text-fg underline-subtle">Browse all articles</a>.</p>
  </section>
  <SiteFooter variant="page" />
</BaseLayout>
