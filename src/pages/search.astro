---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ListRow from "../components/ListRow.astro";
import ArticleDate from "../components/ArticleDate.astro";
---

<BaseLayout title="Search" description="Search every article.">
  <SiteHeader variant="index" current="search" />
  <section aria-labelledby="search-label" class="mt-10 sm:mt-[72px]">
    <label id="search-label" for="search-input" class="block pb-3 text-[15px] font-semibold tracking-[.02em] sm:pb-3.5">Search</label>
    <input
      id="search-input"
      type="search"
      name="q"
      placeholder="Search articles"
      autocomplete="off"
      class="block w-full rounded-none border-0 border-b border-fg bg-transparent px-0 pt-1.5 pb-3 font-serif text-[22px] leading-[1.3] text-fg placeholder:text-fg-3 sm:pb-3.5 sm:text-[28px] sm:leading-[1.25]"
    />
    <p id="search-status" role="status" class="mt-3 text-[14px] text-fg-3 sm:mt-3.5 sm:text-[15px]">Type to search every article.</p>
    <ol id="search-results" class="mt-1 sm:mt-2"></ol>
    <template id="search-result">
      <ListRow>
        <ArticleDate slot="label" />
      </ListRow>
    </template>
  </section>
  <SiteFooter variant="index" />
</BaseLayout>

<script>
  import "../scripts/search";
</script>
